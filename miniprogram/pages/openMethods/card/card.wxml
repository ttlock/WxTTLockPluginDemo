<view class="block">
    <text class="title">当前智能锁：{{keyInfo.lockAlias}}</text>
    <navigator class="iconfont icon-add btn-add"
        url="./add/add"></navigator>
</view>
<view wx:if="{{cardList && cardList.length > 0}}">
    <view wx:for="{{cardList}}" wx:for-item="item" wx:key="cardId" data-index="{{index}}"
        data-value="{{item}}"
        class="tapline"
        hover-class="tapline-hover"
        bindtap="toDetail">
        {{item.cardNumber}} {{item.cardName || ""}}
    </view>
</view>
<view class="description mv-24 mh-16 fc-9" wx:else>暂无IC卡</view>
<view class="description mv-24 mh-16">{{state}}</view>
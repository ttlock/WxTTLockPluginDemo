<!-- 管理指纹 -->
<view class="block">
    <text class="title">指纹: {{fingerprintInfo.fingerprintName || ""}} ({{fingerprintInfo.fingerprintNumber}})</text>
</view>
<form bindsubmit="handleSubmit">
    <view class="form-item">
        <text class="form-item-label">永久开关：</text>
        <switch model:checked="{{permanent}}" type="switch" color="#2886f7"></switch>
    </view>
    <DatespanPicker wx:if="{{!permanent}}" model:value="{{dateSpan}}" id="dateSpan"
        label="有效期"
        start-placeholder="请选择开始时间"
        end-placeholder="请选择结束时间"
        use-minute="{{false}}"
        bindupdate="handleUpdateDateSpan"></DatespanPicker>
    <view class="form-item">
        <button form-type="submit">修改</button>
    </view>
</form>
<view class="form-item">
    <button bindtap="handleDelete">删除</button>
</view>
<view class="description mv-24 mh-16">{{state}}</view>
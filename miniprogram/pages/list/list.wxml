<!-- 智能锁列表 -->
<view class="block flex-row">
    <navigator url="../initLock/initLock" class="mh-16">添加智能锁</navigator>
    <navigator url="../initGateway/initGateway" class="mh-16">添加网关</navigator>
</view>
<view>
    <view wx:for="{{keyList}}" wx:for-item="item" wx:key="keyId" data-index="{{index}}"
        data-value="{{item}}"
        class="tapline"
        hover-class="tapline-hover"
        bindtap="toDetail">{{item.lockAlias}}</view>
</view>